##Stable Isotope and Tissue Nutrient Data##
```{r}
#Read in the raw stable isotope and tissue nutrient data file
N15 <- read.csv("./Stable Isotope Data/Stable_Isotope_Mastersheet.csv")
N15

#Constructing a linear mixed effects model to analyze the data, hoping to better account for the repeated measurements at the same sites over the study period.

library(lme4)
library(lmerTest)

#Creating a lmer for the N15 data. This model will use ALL of th N15 data, because LMERs apparently do not require equal sample size, like ANOVAs do.
model_n15 <- lmer(
  N15 ~ Site * Species * Month +
    (1 | Site:Month),
  data = N15,
  control = lmerControl(
    optimizer = "bobyqa",
    optCtrl = list(maxfun = 100000)
  )
)

anova(model_n15) #The significant three-way interaction effect is the most important result. It indicates that the variables cannot be considered independently from one another, and must all be taken into account when thinking about the data.

summary(model_n15)

n15_emm_site <- emmeans(model_n15,
                        pairwise ~ Site | Species * Month,
                        adjust = "tukey")
pairs(n15_emm_site)
#Checking assumptions of N15 model
#Examining residuals
resid_n15 <- residuals(model_n15)
fitted_n15 <- fitted(model_n15)

